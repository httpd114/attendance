# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------
# 密钥与本机配置（绝不入库）
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config/local.yaml

# ---------------------------------------------------------------------
# 运行时数据：SQLite 与 RAG 索引缓存
# data/ 下的样例制度文档与图片是允许入库的，只排除数据库与缓存
# ---------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
.rag_cache/
data/.rag_cache/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak*

# ---------------------------------------------------------------------
# 测试与演示产生的临时文件
# ---------------------------------------------------------------------
.tmp_test/
tests/.tmp_test/
*.log
agent_demo.db

# curl cookie jar：内含完整 JWT access_token，绝不入库。
# 测试脚本（test_auth.sh / test_kb.sh / test_admin3.sh）统一把运行时
# cookie jar 写入 tests/.tmp_test/（上面已忽略），重跑不会在 tests/ 根目录产生凭据。
# tests/ 根目录的 5 个 *.txt 是早期手工测试留下的【脱敏样本】，
# JWT 已替换为 <REDACTED_JWT>，经 git add -f 显式纳入版本控制；
# 本规则用于阻止今后新增的、未脱敏 cookie jar 被误提交。
tests/*.txt

# ---------------------------------------------------------------------
# WorkBuddy 本地工作数据：工作记忆、重构前备份（含运行时数据库）
# 属于本机内部资料，绝不入库
# ---------------------------------------------------------------------
.workbuddy/

# 应用卡片为本机元数据，含本地绝对路径，不入库
.wbapp_*.genie

# ---------------------------------------------------------------------
# 文档生成流水线：只保留成品（docx / md / 示意图 / 实测证据）
# 中间态 HTML 内嵌 base64 图片，单份可达 700KB，不入库
# ---------------------------------------------------------------------
output/*/stage1/
output/*/stage2/
output/*/working/
output/*/trace/
output/*/pipeline-state.yaml
output/上线交付运行手册-v1.0/html/

# ---------------------------------------------------------------------
# 编辑器 / 操作系统
# ---------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
